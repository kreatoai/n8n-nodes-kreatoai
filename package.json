{
    "name": "n8n-nodes-kreatoai",
    "version": "0.1.0",
    "description": "n8n node for Kreatoai: publish and schedule posts on Facebook, Instagram, TikTok, LinkedIn, YouTube, Bluesky, Google Business and Pinterest.",
    "license": "MIT",
    "homepage": "https://kreatoai.com/developers/n8n",
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "kreatoai",
        "social media",
        "scheduling",
        "facebook",
        "instagram",
        "tiktok",
        "linkedin",
        "youtube",
        "bluesky",
        "pinterest"
    ],
    "author": {
        "name": "Kreatoai",
        "email": "contact@kreatoai.com",
        "url": "https://kreatoai.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kreatoai/n8n-nodes-kreatoai.git"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "bugs": {
        "url": "https://github.com/kreatoai/n8n-nodes-kreatoai/issues"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/KreatoaiApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Kreatoai/Kreatoai.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.55.5",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
